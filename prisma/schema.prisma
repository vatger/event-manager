datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

enum PermissionScope {
  OWN_FIR
  ALL
}

enum EventStatus {
  PLANNING
  SIGNUP_OPEN
  SIGNUP_CLOSED
  ROSTER_PUBLISHED
  DRAFT
  CANCELLED
}

enum DocumentType {
  PLAN
  BRIEFING
  CHART
  OTHER
}

enum NotificationType {
  INFO
  SYSTEM
  EVENT
  OTHER
}

enum GroupKind {
  FIR_LEITUNG
  FIR_TEAM
  CUSTOM
}

enum TaskType {
  CREATE_BANNER
  CREATE_TEXT
  SUBMIT_CLEARING
  REGISTER_MYVATSIM
  CUSTOM
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  SKIPPED
}

model User {
  id                        Int      @id @default(autoincrement())
  cid                       Int      @unique
  name                      String
  rating                    String
  firId                     Int?
  fir                       FIR?     @relation(fields: [firId], references: [id])
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  emailNotificationsEnabled Boolean?

  signups             EventSignup[]
  weeklyEventSignups  WeeklyEventSignup[]
  Notification        Notification[]
  groups              UserGroup[]
  vatgerLeitung       VATGERLeitung?
  blockedDatesCreated CalendarBlockedDate[] @relation("BlockedDateCreator")
  weeklyEventManagers WeeklyEventManager[]
  assignedTasks       EventTask[]
  responsibleEvents   EventResponsible[]

  commentsReceived    UserComment[]         @relation("CommentTarget")
  commentsWritten     UserComment[]         @relation("CommentAuthor")
}

model FIR {
  id                 Int                        @id @default(autoincrement())
  code               String                     @unique
  name               String
  events             Event[]
  members            User[]
  groups             Group[]
  weeklyEventConfigs WeeklyEventConfiguration[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
}

model Event {
  id              Int         @id @default(autoincrement())
  name            String
  description     String
  bannerUrl       String?
  bannerVisible   Boolean     @default(false) // Banner only shown publicly after clearing approval
  startTime       DateTime
  endTime         DateTime
  airports        Json // Array of ICAO codes
  signupDeadline  DateTime?
  signupReminderSent Boolean @default(false) // Whether 1-day-before reminder was sent to signed-up users
  signupSlotMinutes Int?      @default(30) // Duration of signup availability slots in minutes (15 or 30)
  staffedStations Json? // Array of Callsigns
  status          EventStatus @default(PLANNING)
  rosterlink      String?
  createdById     Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  firCode String?
  fir     FIR?    @relation(fields: [firCode], references: [code])

  responsibles EventResponsible[]
  signups      EventSignup[]
  Notification Notification[]
  tasks        EventTask[]
  roster       EventRoster?
}

// Roster editor for non-recurring (large) events:
// per-event staffing plan built from signups on a 15/30-minute grid
model EventRoster {
  id          Int      @id @default(autoincrement())
  eventId     Int      @unique
  slotMinutes Int      @default(30) // Grid size in minutes (15 or 30)
  // Veröffentlichte Fassung: der Stand, den Teilnehmer sehen. Der Editor
  // arbeitet weiter am Live-Stand; erst "Änderungen veröffentlichen"
  // schreibt ihn hierher.
  publishedAt   DateTime?
  publishedData Json?
  // Bewusst ignorierte Planungshinweise (Liste stabiler Warnungs-Schlüssel).
  // Gilt für alle Bearbeiter, damit niemand denselben Hinweis erneut wegklickt.
  dismissedWarnings Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stations    EventRosterStation[]
  assignments EventRosterAssignment[]
  notes       EventRosterNote[]
  editors     EventRosterEditor[]
  snapshots   EventRosterSnapshot[]
}

// Interne Planungsnotiz des Event-Teams zu einem Controller (pro Roster).
// Trägt zusätzlich eine Ampel-Markierung ("green" | "amber" | "red"), mit der
// sich Controller beim Planen schnell einordnen lassen.
model EventRosterNote {
  id        Int      @id @default(autoincrement())
  rosterId  Int
  userCID   Int
  note      String   @db.Text
  flag      String?  @db.VarChar(16)
  authorCID Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roster EventRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)

  @@unique([rosterId, userCID])
  @@index([rosterId])
}

// Explizit berechtigte Bearbeiter eines Rosters (von Verantwortlichen eingetragen)
model EventRosterEditor {
  id        Int      @id @default(autoincrement())
  rosterId  Int
  userCID   Int
  addedByCID Int?
  createdAt DateTime @default(now())

  roster EventRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)

  @@unique([rosterId, userCID])
  @@index([rosterId])
}

// Gespeicherter Zwischenstand eines Rosters (Snapshot zum Zurückkehren)
model EventRosterSnapshot {
  id           Int      @id @default(autoincrement())
  rosterId     Int
  name         String
  data         Json // { slotMinutes, stations: [...], assignments: [...] }
  createdByCID Int?
  createdAt    DateTime @default(now())

  roster EventRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)

  @@index([rosterId])
}

// Confirmed stations of a roster (imported from Event.staffedStations, then editable)
model EventRosterStation {
  id        Int    @id @default(autoincrement())
  rosterId  Int
  callsign  String
  sortOrder Int    @default(0)

  roster      EventRoster             @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  assignments EventRosterAssignment[]

  @@unique([rosterId, callsign])
  @@index([rosterId])
}

// A block on a station timeline within the event.
// type = "controller": a signed-up controller staffs the station (userCID set)
// type = "custom":     a custom label block, e.g. "Combined (MGN)" or "Training" (label set)
model EventRosterAssignment {
  id        Int      @id @default(autoincrement())
  rosterId  Int
  stationId Int
  type      String   @default("controller") // "controller" | "custom"
  userCID   Int? // null for custom blocks
  label     String? // custom block label, e.g. "Combined (MGN)"
  color     String? // optional color hint for custom blocks
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roster  EventRoster        @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  station EventRosterStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([rosterId])
  @@index([stationId])
  @@index([userCID])
}

model EventResponsible {
  id        Int      @id @default(autoincrement())
  eventId   Int
  userCID   Int
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userCID], references: [cid], onDelete: Cascade)

  @@unique([eventId, userCID])
  @@index([eventId])
  @@index([userCID])
}

model EventSignup {
  id                    Int       @id @default(autoincrement())
  eventId               Int
  userCID               Int
  availability          Json
  breakrequests         String?
  preferredStations     String?
  remarks               String?
  excludedAirports      Json? // Array of ICAO codes the user excluded from multi-airport events
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime? // Soft delete timestamp
  deletedBy             Int? // CID of user who deleted
  modifiedAfterDeadline Boolean   @default(false) // Flag for changes after deadline
  changeLog             Json? // Array of changes made to the signup
  changesAcknowledged   Boolean   @default(false) // Flag to mark if event team has acknowledged changes
  signedUpAfterDeadline Boolean   @default(false) // Flag for signups created after deadline

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userCID], references: [cid])

  @@unique([eventId, userCID]) // verhindert doppelte Signups
}

model Notification {
  id        Int              @id @default(autoincrement())
  userCID   Int
  eventId   Int?
  type      NotificationType
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User   @relation(fields: [userCID], references: [cid])
  event Event? @relation(fields: [eventId], references: [id])

  @@index([userCID, readAt])
  @@index([eventId])
}

model Permission {
  id          Int               @id @default(autoincrement())
  key         String            @unique // e.g. "event.create", "event.edit", "group.manage"
  description String?
  groups      GroupPermission[]
}

model Group {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  kind        GroupKind @default(CUSTOM)
  firId       Int? // null = global Gruppe
  fir         FIR?      @relation(fields: [firId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  permissions GroupPermission[]
  members     UserGroup[]

  @@unique([name, firId]) // gleicher Name pro FIR nur einmal
}

model GroupPermission {
  id           Int             @id @default(autoincrement())
  groupId      Int
  permissionId Int
  scope        PermissionScope @default(OWN_FIR)

  group      Group      @relation(fields: [groupId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([groupId, permissionId, scope])
}

model UserGroup {
  id      Int @id @default(autoincrement())
  userCID Int
  groupId Int

  user  User  @relation(fields: [userCID], references: [cid])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userCID, groupId])
}

model VATGERLeitung {
  id        Int      @id @default(autoincrement())
  userCID   Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userCID], references: [cid])
}

// Training system caches
model TrainingEndorsementCache {
  id        Int      @id @default(autoincrement())
  userCID   Int
  position  String
  createdAt DateTime
  updatedAt DateTime
  fetchedAt DateTime @default(now())

  @@unique([userCID, position])
  @@index([userCID])
  @@index([fetchedAt])
}

model TrainingSoloCache {
  id        Int      @id @default(autoincrement())
  userCID   Int
  position  String
  expiry    DateTime
  createdAt DateTime
  updatedAt DateTime
  fetchedAt DateTime @default(now())

  @@unique([userCID, position])
  @@index([userCID])
  @@index([expiry])
}

model TrainingFamiliarizationCache {
  id         Int      @id @default(autoincrement())
  userCID    Int
  sectorName String
  sectorFir  String
  fetchedAt  DateTime @default(now())

  @@unique([userCID, sectorFir, sectorName])
  @@index([userCID])
  @@index([sectorFir])
}

model TrainingCacheMetadata {
  id          Int      @id @default(autoincrement())
  lastUpdated DateTime
  forceUpdate Boolean  @default(false)
}

model EventSignupCache {
  id        Int       @id @default(autoincrement())
  eventId   Int       @unique
  data      Json // enthält die komplette SignupTableResponse (inkl. Endorsements)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?
}

model CalendarBlockedDate {
  id          Int      @id @default(autoincrement())
  startDate   DateTime
  endDate     DateTime
  startTime   String? // Format: "HH:mm" (e.g., "14:30")
  endTime     String? // Format: "HH:mm" (e.g., "18:00")
  reason      String
  description String?
  createdById Int
  createdBy   User     @relation("BlockedDateCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Discord Bot Configuration
model WeeklyEventConfiguration {
  id      Int    @id @default(autoincrement())
  firId   Int?
  fir     FIR?   @relation(fields: [firId], references: [id])
  name    String // e.g., "München Mittwoch", "Frankfurt Friday"
  weekday Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday

  // Pattern configuration for recurring events
  // e.g., for "2 weeks on, 1 week off": weeksOn=2, weeksOff=1
  weeksOn      Int      @default(1) // How many consecutive weeks the event occurs
  weeksOff     Int      @default(0) // How many weeks off after the "on" period
  skipInterval Int      @default(0) // Skip every Nth occurrence (0 = disabled), e.g. 3 = every 3rd occurrence is skipped
  startDate    DateTime // When the pattern starts

  // Event details
  airports        Json? // Array of ICAO codes
  startTime       String? // Event start time in HH:mm format (local time Europe/Berlin)
  endTime         String? // Event end time in HH:mm format (local time Europe/Berlin)
  description     String? @db.Text
  
  // Staffing configuration
  minStaffing      Int?     @default(0) // Minimum required staff
  requiresRoster   Boolean  @default(false) // Whether positions need to be assigned
  staffedStations  Json? // Array of station callsigns that need rostering
  signupDeadlineHours Int?  @default(24) // Hours before event when signup closes

  // Display
  bannerUrl   String?  @db.Text // Optional banner image URL for public display

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occurrences WeeklyEventOccurrence[]
  managers    WeeklyEventManager[]
}

// Generated occurrences for weekly events (for easier querying and display)
model WeeklyEventOccurrence {
  id                 Int                      @id @default(autoincrement())
  configId           Int
  config             WeeklyEventConfiguration @relation(fields: [configId], references: [id], onDelete: Cascade)
  date               DateTime // The specific date this event occurs
  myVatsimChecked    Boolean                  @default(false) // Was the myVATSIM check performed?
  myVatsimRegistered Boolean? // Is the event registered in myVATSIM?
  staffingChecked    Boolean                  @default(false) // Was staffing checked?
  staffingSufficient Boolean? // Does the event have sufficient staffing?
  
  // Signup and roster management
  signupDeadline     DateTime? // Calculated deadline for this occurrence
  signupStatus       String    @default("auto") // "auto", "open", "closed" - controls signup availability
  rosterPublished    Boolean   @default(false) // Whether roster has been published
  rosterPublishedAt  DateTime? // When roster was published
  rosterScheduledPublish Boolean @default(false) // Auto-publish roster when signup deadline passes
  eventId            Int? // Link to created Event if converted
  
  createdAt          DateTime                 @default(now())

  signups WeeklyEventSignup[]
  rosters WeeklyEventRoster[]

  @@unique([configId, date])
  @@index([date])
  @@index([eventId])
}

// User signups for weekly events
model WeeklyEventSignup {
  id                Int      @id @default(autoincrement())
  occurrenceId      Int
  occurrence        WeeklyEventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  userCID           Int
  remarks           String? @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user  User  @relation(fields: [userCID], references: [cid])

  @@unique([occurrenceId, userCID])
  @@index([userCID])
  @@index([occurrenceId])
}

// Roster assignments for weekly events
model WeeklyEventRoster {
  id             Int      @id @default(autoincrement())
  occurrenceId   Int
  occurrence     WeeklyEventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  userCID        Int
  station        String // Callsign assigned to this user
  assignmentType String   @default("normal") // "normal", "cpt", "training"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([occurrenceId, station])
  @@index([occurrenceId])
  @@index([userCID])
}

model CronJobStatus {
  id              Int      @id @default(autoincrement())
  jobName         String   @unique // Unique identifier for the cron job
  displayName     String   // Human-readable name
  description     String   @db.Text // What the job does
  schedule        String   // Cron schedule expression
  isActive        Boolean  @default(true)
  lastRunAt       DateTime? // When the job last ran
  lastRunStatus   String?  // "success" or "error"
  lastRunDuration Int?     // Duration in milliseconds
  lastError       String?  @db.Text // Error message if failed
  runCount        Int      @default(0) // Total number of runs
  errorCount      Int      @default(0) // Total number of errors
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([jobName])
}

// Weekly-specific manager: grants a user access to manage a specific weekly event
// without requiring FIR-wide permissions.
model WeeklyEventManager {
  id        Int      @id @default(autoincrement())
  userCID   Int
  configId  Int
  createdAt DateTime @default(now())

  user   User                     @relation(fields: [userCID], references: [cid], onDelete: Cascade)
  config WeeklyEventConfiguration @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([userCID, configId])
  @@index([userCID])
  @@index([configId])
}

// Event tasks for tracking event preparation steps
model EventTask {
  id          Int        @id @default(autoincrement())
  eventId     Int
  type        TaskType
  title       String
  description String?    @db.Text
  status      TaskStatus @default(OPEN)
  dueDate     DateTime?
  assigneeCID Int?

  // For REGISTER_MYVATSIM task: manual confirmation + API check
  myVatsimManualCheck Boolean  @default(false)
  myVatsimRegistered  Boolean?

  // Notification tracking
  deadlineNotified Boolean @default(false)

  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignee User? @relation(fields: [assigneeCID], references: [cid])

  @@index([eventId])
  @@index([assigneeCID])
  @@index([dueDate])
}

// Persistent admin notes/comments about a specific user
model UserComment {
  id        Int      @id @default(autoincrement())
  userCID   Int
  authorCID Int
  comment   String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation("CommentTarget", fields: [userCID], references: [cid], onDelete: Cascade)
  author User @relation("CommentAuthor", fields: [authorCID], references: [cid], onDelete: Cascade)

  @@index([userCID])
  @@index([authorCID])
}

